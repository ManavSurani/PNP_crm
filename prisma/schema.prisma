// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// MODULE: Auth & Role Management
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  SALES_EXECUTIVE
  PROJECT_MANAGER
  SITE_SUPERVISOR
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SALES_EXECUTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth Relations
  accounts      Account[]
  sessions      Session[]

  assignedLeads Lead[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Device tracking
  userAgent    String?
  ipAddress    String?
  lastActive   DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default("global")
  sessionMaxAge Int  @default(2592000) // Default 30 days in seconds
  whatsappDispatchNumber String?
  updatedAt DateTime @updatedAt
}



// -----------------------------------------------------------------------------
// MODULE: Leads & Inquiry Management
// -----------------------------------------------------------------------------

enum InquirySource {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  REFERENCE
  DIRECT_CALL
  WEBSITE
  WALK_IN
  OTHER
}

enum ServiceType {
  INTERIOR_DESIGN
  MODULAR_KITCHEN
  WARDROBE_PLANNING
  FULL_HOME_INTERIOR
  TWO_BHK_INTERIOR
  THREE_BHK_INTERIOR
  VILLA_INTERIOR
  OFFICE_INTERIOR
  CUSTOM_FURNITURE_DESIGN
  MATERIAL_SUPPLY
  LABOUR_ONLY
  FULL_COMBO_PROJECT
  SOFA_WORK
  CHAIR_WORK
  REPAIRING_WORK
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum LeadStatus {
  NEW_INQUIRY
  FOLLOW_UP
  MEETING_SCHEDULED
  WON_ORDER
  CANCELLED
}

model Lead {
  id              String        @id @default(uuid())
  customerName    String
  contactNumber   String
  alternateNumber String?
  fullAddress     String?
  inquirySource   InquirySource @default(OTHER)
  serviceType     ServiceType   @default(OTHER)
  priority        Priority      @default(MEDIUM)
  status          LeadStatus    @default(NEW_INQUIRY)
  assignedStaffId String?
  assignedStaff   User?         @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Extra Details 
  budgetRange       String?
  requirementDetails String?
  siteLocation      String?
  landmark          String?
  preferredVisitTime String?

  // Cancellations & Reactivation
  isCancelled       Boolean   @default(false)
  cancelReason      String?
  reactivatedAt     DateTime?
  reactivationNote  String?

  // New Service-Based Relations
  requirement Requirement?

  followUps   FollowUp[]
  meetings    Meeting[]
  quotations  Quotation[]
  orders      Order[]
  transactions  LeadTransaction[]
  leadNotes     LeadNote[]
}

model Requirement {
  id              String   @id @default(uuid())
  leadId          String   @unique
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyType    String?  // 2BHK, 3BHK, Villa, etc.
  areaSize        String?  // sq.ft.
  numRooms        Int?
  kitchenType     String?
  wardrobeCount   Int?
  tvUnitReq       Boolean  @default(false)
  bedroomFurnitureReq Boolean @default(false)
  officeSetupReq  Boolean  @default(false)
  materialPref    String?
  finishPref      String?
  budgetRange     String?
  timeline        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// MODULE: Call Follow-up & Notes Timeline
// -----------------------------------------------------------------------------

enum CallOutcome {
  PICKED
  NOT_PICKED
  CALL_LATER
  WRONG_NUMBER
  CANCELLED
}

model FollowUp {
  id              String      @id @default(uuid())
  leadId          String
  lead            Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  attemptNumber   Int         @default(1)
  outcome         CallOutcome @default(NOT_PICKED)
  nextCallDate    DateTime?
  nextCallTime    String?
  noteGiven       String?
  scheduledDate   DateTime    @default(now()) // When this follow up is supposed to happen
  completedDate   DateTime?   // Null means it's pending
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// Note model removed in favor of LeadNote


// -----------------------------------------------------------------------------
// MODULE: Meeting Management
// -----------------------------------------------------------------------------

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

model Meeting {
  id            String        @id @default(uuid())
  leadId        String
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  address       String
  date          DateTime
  time          String
  status        MeetingStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// -----------------------------------------------------------------------------
// MODULE: Quotation Module
// -----------------------------------------------------------------------------

enum PackageType {
  DESIGN_ONLY
  MATERIALS_ONLY
  FULL_COMBO
  CUSTOM
}

model Quotation {
  id            String          @id @default(uuid())
  leadId        String
  lead          Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotationNo   String          @unique
  issueDate     DateTime        @default(now())
  expiryDate    DateTime?
  
  // Package & Project Costs
  packageType   PackageType     @default(FULL_COMBO)
  designCost    Float           @default(0)
  materialCost  Float           @default(0)
  labourCost    Float           @default(0)
  transportCost Float           @default(0)
  supervisionCharges Float      @default(0)
  siteVisitCharges   Float      @default(0)
  
  gstPercentage Float           @default(0)
  gstAmount     Float           @default(0)
  discount      Float           @default(0)
  finalTotal    Float           @default(0)
  status        String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  
  // Terms & Scope
  workScope       String?
  milestoneTerms  String?
  projectTimeline String?
  
  version         Int             @default(1)
  
  items         QuotationItem[]
  milestones    QuotationMilestone[]
  
  orders        Order[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  section     String    @default("GENERAL") // DESIGN, MATERIAL, LABOUR, etc.
  description String
  quantity    Int       @default(1)
  unitPrice   Float     @default(0)
  totalPrice  Float     @default(0)
}

model QuotationMilestone {
  id            String    @id @default(uuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description   String
  percentage    Float?
  amount        Float
  status        String    @default("PENDING") // PENDING, PAID
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// MODULE: Order & Production Management
// -----------------------------------------------------------------------------

enum OrderStatus {
  CONFIRMED
  DESIGN
  MATERIAL_PROCUREMENT
  PRODUCTION
  INSTALLATION
  QUALITY_CHECK
  HANDOVER
  COMPLETED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid())
  leadId        String
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  quotationId   String?     // Link to the quotation that generated this order
  quotation     Quotation?  @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  orderNo       String      @unique
  status        OrderStatus @default(DESIGN)
  packageType   PackageType @default(FULL_COMBO)
  
  totalAmount   Float       @default(0)
  advanceAmount Float       @default(0)
  pendingAmount Float       @default(0)

  startDate     DateTime?
  endDate       DateTime?

  isBlocked     Boolean     @default(false)
  blockReason   String?
  
  assignments   WorkerAssignment[]
  updates       OrderUpdate[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderUpdate {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  userId      String?     // Who made the update
  createdAt   DateTime    @default(now())
}

// -----------------------------------------------------------------------------
// MODULE: Payment & Financials
// -----------------------------------------------------------------------------

// Payment and Expense models consolidated into LeadTransaction


// -----------------------------------------------------------------------------
// MODULE: Worker & Supplier Management
// -----------------------------------------------------------------------------

enum WorkerType {
  CARPENTER
  INSTALLER
  HELPER
}

model Worker {
  id           String             @id @default(uuid())
  name         String
  phone        String
  type         WorkerType         @default(CARPENTER)
  dailyRate    Float?
  assignments  WorkerAssignment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model WorkerAssignment {
  id        String   @id @default(uuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String   @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id           String            @id @default(uuid())
  name         String
  phone        String
  address      String?
  materials    String?           // What they supply
  payments     SupplierPayment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model SupplierPayment {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// MODULE: System & Security (Phase 7)
// -----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // CREATE, UPDATE, DELETE
  entity      String   // LEAD, QUOTATION, ORDER, PAYMENT, EXPENSE
  entityId    String
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   // Target user
  title       String
  message     String
  type        String   @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  link        String?  // Optional target page
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model LeadTransaction {
  id          String          @id @default(cuid())
  leadId      String?
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Float
  date        DateTime
  paidTo      String
  category    String
  paymentMode String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model LeadNote {
  id          String   @id @default(cuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content     String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TransactionType {
  RECEIVED
  EXPENSE
}
