generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:C:\\Vs\\pnp_crm\\_data\\crm.db"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          String         @default("SALES_EXECUTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  executionLogs ExecutionLog[]
  assignedLeads Lead[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  lastActive   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id                     String   @id @default("global")
  sessionMaxAge          Int      @default(2592000)
  whatsappDispatchNumber String?
  analyticsPin           String?
  isAnalyticsPinEnabled  Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Lead {
  id                  String             @id @default(uuid())
  customerName        String
  contactNumber       String
  normalizedPhone     String?
  alternateNumber     String?
  fullAddress         String?
  inquirySource       String             @default("OTHER")
  serviceType         String             @default("OTHER")
  priority            String             @default("MEDIUM")
  status              String             @default("NEW_INQUIRY")
  assignedStaffId     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  budgetRange         String?
  requirementDetails  String?
  siteLocation        String?
  landmark            String?
  preferredVisitTime  String?
  isCancelled         Boolean            @default(false)
  cancelReason        String?
  isFinanciallyClosed Boolean            @default(false)
  isProjectCompleted  Boolean            @default(false)
  reactivatedAt       DateTime?
  reactivationNote    String?
  initialDealAmount   Float              @default(0)
  initialDealNotes    String?
  followUps           FollowUp[]
  assignedStaff       User?              @relation(fields: [assignedStaffId], references: [id])
  financialLogs       LeadFinancialLog[]
  leadNotes           LeadNote[]
  transactions        LeadTransaction[]
  meetings            Meeting[]
  orders              Order[]
  project             Project?
  projectQuotations   ProjectQuotation[]
  quotations          Quotation[]
  requirement         Requirement?

  @@index([status])
  @@index([isCancelled])
  @@index([createdAt])
  @@index([assignedStaffId])
}

model Requirement {
  id                  String   @id @default(uuid())
  leadId              String   @unique
  propertyType        String?
  areaSize            String?
  numRooms            Int?
  kitchenType         String?
  wardrobeCount       Int?
  tvUnitReq           Boolean  @default(false)
  bedroomFurnitureReq Boolean  @default(false)
  officeSetupReq      Boolean  @default(false)
  materialPref        String?
  finishPref          String?
  budgetRange         String?
  timeline            String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model FollowUp {
  id             String    @id @default(uuid())
  leadId         String
  attemptNumber  Int       @default(1)
  outcome        String    @default("NOT_PICKED")
  nextCallDate   DateTime?
  nextCallTime   String?
  noteGiven      String?
  scheduledDate  DateTime  @default(now())
  completedDate  DateTime?
  isLongDistance Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([completedDate])
  @@index([scheduledDate])
  @@index([leadId])
  @@index([outcome])
}

model Meeting {
  id        String   @id @default(uuid())
  leadId    String
  address   String
  date      DateTime
  time      String
  status    String   @default("SCHEDULED")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Quotation {
  id                 String               @id @default(uuid())
  leadId             String
  quotationNo        String               @unique
  issueDate          DateTime             @default(now())
  expiryDate         DateTime?
  packageType        String               @default("FULL_COMBO")
  designCost         Float                @default(0)
  materialCost       Float                @default(0)
  labourCost         Float                @default(0)
  transportCost      Float                @default(0)
  supervisionCharges Float                @default(0)
  siteVisitCharges   Float                @default(0)
  gstPercentage      Float                @default(0)
  gstAmount          Float                @default(0)
  discount           Float                @default(0)
  finalTotal         Float                @default(0)
  status             String               @default("DRAFT")
  workScope          String?
  milestoneTerms     String?
  projectTimeline    String?
  version            Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  orders             Order[]
  lead               Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  items              QuotationItem[]
  milestones         QuotationMilestone[]

  @@index([status])
  @@index([leadId])
  @@index([quotationNo])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  section     String    @default("GENERAL")
  description String
  quantity    Float     @default(1)
  unitPrice   Float     @default(0)
  totalPrice  Float     @default(0)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationMilestone {
  id          String    @id @default(uuid())
  quotationId String
  description String
  percentage  Float?
  amount      Float
  status      String    @default("PENDING")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Order {
  id            String             @id @default(uuid())
  leadId        String
  quotationId   String?
  orderNo       String             @unique
  status        String             @default("DESIGN")
  packageType   String             @default("FULL_COMBO")
  totalAmount   Float              @default(0)
  advanceAmount Float              @default(0)
  pendingAmount Float              @default(0)
  startDate     DateTime?
  endDate       DateTime?
  isBlocked     Boolean            @default(false)
  blockReason   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  quotation     Quotation?         @relation(fields: [quotationId], references: [id])
  lead          Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  updates       OrderUpdate[]
  assignments   WorkerAssignment[]

  @@index([status])
  @@index([leadId])
  @@index([orderNo])
}

model OrderUpdate {
  id         String   @id @default(uuid())
  orderId    String
  fromStatus String?
  toStatus   String
  note       String?
  userId     String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Worker {
  id          String             @id @default(uuid())
  name        String
  phone       String
  type        String             @default("CARPENTER")
  dailyRate   Float?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  assignments WorkerAssignment[]
}

model WorkerAssignment {
  id        String   @id @default(uuid())
  workerId  String
  orderId   String
  status    String   @default("ASSIGNED")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            String            @id @default(uuid())
  name          String
  contactPerson String?
  phone         String
  gstNumber     String?
  address       String?
  materials     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  payments      SupplierPayment[]
}

model SupplierPayment {
  id         String   @id @default(uuid())
  supplierId String
  amount     Float
  date       DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  String?
  newValue  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LeadTransaction {
  id                String   @id @default(cuid())
  leadId            String?
  type              String
  amount            Float
  date              DateTime
  paidTo            String
  category          String
  paymentMode       String
  source            String   @default("GENERAL")
  isSystemGenerated Boolean  @default(false)
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([date])
  @@index([category])
}

model LeadNote {
  id          String   @id @default(cuid())
  leadId      String?
  content     String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ProjectField {
  id         String             @id @default(uuid())
  name       String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  quotations ProjectQuotation[]
  vendors    ProjectVendor[]
}

model ProjectVendor {
  id         String                 @id @default(uuid())
  fieldId    String
  name       String
  phone      String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  quotations ProjectQuotation[]
  field      ProjectField           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  contacts   ProjectVendorContact[]
}

model ProjectVendorContact {
  id        String        @id @default(uuid())
  vendorId  String
  name      String?
  phone     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  vendor    ProjectVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model ProjectQuotation {
  id               String           @id @default(uuid())
  customerId       String
  fieldId          String
  vendorId         String
  amount           Float
  priority         Int              @default(0)
  isPriorityLocked Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  payments         ProjectPayment[]
  vendor           ProjectVendor    @relation(fields: [vendorId], references: [id])
  field            ProjectField     @relation(fields: [fieldId], references: [id])
  customer         Lead             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([fieldId])
  @@index([vendorId])
}

model ProjectPayment {
  id                 String           @id @default(uuid())
  projectQuotationId String
  amount             Float
  paidOn             DateTime
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  projectQuotation   ProjectQuotation @relation(fields: [projectQuotationId], references: [id], onDelete: Cascade)

  @@index([projectQuotationId])
}

model Project {
  id                  String         @id @default(uuid())
  customerId          String         @unique
  name                String?
  startedOn           DateTime       @default(now())
  estimatedCompletion DateTime?
  isCompleted         Boolean        @default(false)
  completedOn         DateTime?
  createdAt           DateTime       @default(now())
  executionLogs       ExecutionLog[]
  milestones          Milestone[]
  customer            Lead           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  sequence    Int
  name        String
  description String?
  status      String    @default("pending")
  phase       String    @default("General")
  progress    Int?
  delayDays   Int?
  delayReason String?
  startedOn   DateTime?
  completedOn DateTime?
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sequence])
}

model ExecutionLog {
  id        String   @id @default(uuid())
  projectId String
  logText   String
  logType   String   @default("update")
  loggedOn  DateTime @default(now())
  loggedBy  String?
  createdAt DateTime @default(now())
  logger    User?    @relation(fields: [loggedBy], references: [id])
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([loggedOn])
}

model LeadFinancialLog {
  id        String   @id @default(cuid())
  leadId    String
  action    String
  details   String
  amount    Float?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}
